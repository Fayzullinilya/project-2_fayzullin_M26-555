[13.160187244415283,"o","\u001b[2J\u001b[m\u001b[HWindows PowerShell\r\n(C) Корпорация Майкрософт (Microsoft Corporation). Все права защищены.\r\n\r\nПопробуйте новую кроссплатформенную оболочку PowerShell (https://aka.ms/pscore6)\u001b]0;C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\u0007\u001b[?25h"]
[13.176088333129883,"o","\u001b[25l\u001b[6;1H\u001b[?25h"]
[13.647528409957886,"o","PS> "]
[13.849263668060303,"o","database"]
[14.748711585998535,"o","\r\n"]
[15.133066892623901,"o","***Процесс работы с таблицей***\r\n"]
[15.134218692779541,"o","Функции:\u001b[84X\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\u001b[20X\r\n<command> list_tables - показать список всех таблиц\u001b[41X\r\n<command> drop_table <имя_таблицы> - удалить таблицу\u001b[40X\r\n\u001b[92X\r\n***Операции с данными***\u001b[68X\r\nФункции:\u001b[84X\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r"]
[15.13451337814331,"o","\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r"]
[15.134891033172607,"o","\n<command> select from <имя_таблицы> - прочитать все записи.\r"]
[15.135288000106812,"o","\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.      \r"]
[15.135581016540527,"o","\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r"]
[15.135855436325073,"o","\n<command> info <имя_таблицы> - вывести информацию о таблице.\r"]
[15.136139392852783,"o","\n"]
[15.136406183242798,"o","\nОбщие команды:\r"]
[15.136695623397827,"o","\n<command> exit - выход из программы\r"]
[15.136932849884033,"o","\n<command> help - справочная информация\r"]
[15.137197017669678,"o","\n"]
[15.147605180740356,"o","\n>>>Введите команду:\u001b[1C"]
[19.6330304145813,"o","create_table Users Name:str ag"]
